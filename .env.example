# Per-host settings (written by install_coti-full-node.sh). Packaging defaults (image tag, NETWORK) live in installer.env.

FULLNODE_EXT_IP=
FULLNODE_FQDN=

NGINX_ENABLED=false

# Off by default. Enable with install flag --with-frp (wizard tunnel).
# When enabled: frpc → internal nginx-frpc-gateway (Docker-only, HTTP) → node / operator dashboard.
# No host TLS or Certbot; HTTPS terminates at COTI's edge.
FRPC_ENABLED=false
# Optional legacy: if set, used for any frpc-*.toml server not set below
FRPS_SERVER_ADDR=
FRPS_SERVER_ADDR_1=virginia.fullnode.testnet.coti.io
FRPS_SERVER_ADDR_2=frankfurt.fullnode.testnet.coti.io
FRPS_SERVER_PORT=7000
FRPC_CUSTOM_DOMAIN=
FRPC_AUTH_TOKEN=

# Host TCP port mapped to container JSON-RPC (container always listens on 8545).
COTI_FULL_NODE_RPC_LOCAL_PORT=8545

# After start: operator dashboard at http://127.0.0.1:8090 on the host.
# With Nginx TLS or FRPC, use path /operator/ on your HTTPS host (see install output).
